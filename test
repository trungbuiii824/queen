local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local CollectionService = game:GetService("CollectionService")
local LocalPlayer = Players.LocalPlayer
local Networking = require(ReplicatedStorage.SharedModules.Networking)
local Steal = Networking.Steal
local StealFlags = require(ReplicatedStorage.SharedModules.Flags.StealFlags)
local Gardens = Workspace:FindFirstChild("Gardens")
local GardenZoneData = ReplicatedStorage:FindFirstChild("GardenZoneData")

local CONFIG = {
    Mode = "loop", StealCount = 10, StealDelay = 0.3, LoopInterval = 60,
    WaitForOwnerLeave = true, OwnerCheckInterval = 5, TeleportToTarget = true,
    InstantOnly = true, PrintStats = false, Notify = false,
}
local State = { Running = false, Thread = nil, Stealing = false, Stats = { Stolen = 0, Failed = 0, Skipped = 0 } }

local function IsNight()
    local n = ReplicatedStorage:FindFirstChild("Night")
    return n and n.Value == true
end

local function IsOwnerInGarden(uid)
    if not GardenZoneData then return false end
    local p = Players:GetPlayerByUserId(uid)
    if not p then return false end
    local zone = GardenZoneData:FindFirstChild(p.Name)
    if not zone then return false end
    local pid = p:GetAttribute("PlotId")
    return pid and tonumber(zone.Value) == tonumber(pid)
end

local function WaitForOwnerLeave(uid)
    if not CONFIG.WaitForOwnerLeave then return true end
    if not IsOwnerInGarden(uid) then return true end
    local w = 0
    while State.Running and w < 60 do
        if not IsOwnerInGarden(uid) then return true end
        task.wait(CONFIG.OwnerCheckInterval); w = w + CONFIG.OwnerCheckInterval
    end
    return false
end

local function FindStealableFruits()
    local fruits, seen = {}, {}
    local myPid = LocalPlayer:GetAttribute("PlotId")
    for _, prompt in pairs(CollectionService:GetTagged("StealPrompt")) do
        if not prompt:IsA("ProximityPrompt") or not prompt.Enabled then continue end
        local model = prompt.Parent and prompt.Parent:FindFirstAncestorWhichIsA("Model")
        if not model then continue end
        local inG, pName, plot = false, "", nil
        local c = model.Parent
        while c do
            if c.Name:find("^Plot%d+$") then inG, pName, plot = true, c.Name, c; break end
            if c.Name == "Gardens" then break end
            c = c.Parent
        end
        if not inG then continue end
        local pn = tonumber(pName:match("(%d+)"))
        if pn and myPid and tonumber(myPid) and pn <= tonumber(myPid) then continue end
        local plantId = model:GetAttribute("PlantId")
        local fruitId = model:GetAttribute("FruitId") or ""
        if not plantId then continue end
        local key = plantId.."|"..fruitId
        if seen[key] then continue end; seen[key] = true
        local owner = 0
        local po = plot and plot:FindFirstChild("PlotOwner")
        if po then
            if type(po.Value) == "number" then owner = po.Value
            elseif type(po.Value) == "string" then local pp = Players:FindFirstChild(po.Value); if pp then owner = pp.UserId end end
        end
        if owner == 0 then owner = model:GetAttribute("UserId") or 0 end
        local sn = model:GetAttribute("SeedName") or model:GetAttribute("CorePartName")
        local stealable = true
        if sn then stealable = StealFlags.IsPlantStealable(sn) end
        table.insert(fruits, { PlantId = plantId, FruitId = fruitId, OwnerUserId = owner, Plot = pName, Pos = model:GetPivot().Position, HoldDuration = prompt.HoldDuration, Stealable = stealable, SeedName = sn, Prompt = prompt, Model = model })
    end
    return fruits
end

local function StealFruit(target)
    if State.Stealing then return false end
    if CONFIG.TeleportToTarget then
        local r = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if r then r.CFrame = CFrame.new(target.Pos.X + math.random(-1,1), target.Pos.Y + 3, target.Pos.Z + math.random(-1,1)); task.wait(0.15) end
    end
    if target.HoldDuration > 0 and not CONFIG.InstantOnly then
        local p = target.Prompt
        if p and p:IsDescendantOf(workspace) then
            pcall(function() p:InputHoldBegin(); task.wait(target.HoldDuration + 0.1); p:InputHoldEnd() end)
            State.Stats.Stolen = State.Stats.Stolen + 1; return true
        end
        return false
    else
        local ok = pcall(function() Steal.BeginSteal:Fire(target.OwnerUserId, target.PlantId, target.FruitId) end)
        if ok then task.wait(0.05)
            local ok2 = pcall(function() Steal.CompleteSteal:Fire() end)
            if ok2 then State.Stats.Stolen = State.Stats.Stolen + 1; return true end
        end
        pcall(function() Steal.CancelSteal:Fire() end); State.Stats.Failed = State.Stats.Failed + 1
        return false
    end
end

local function RunStealCycle()
    if not IsNight() then return 0 end
    local all = FindStealableFruits()
    local fruits = {}
    for _, f in ipairs(all) do if f.Stealable and (not CONFIG.InstantOnly or f.HoldDuration <= 0) then table.insert(fruits, f) else State.Stats.Skipped = State.Stats.Skipped + 1 end end
    if #fruits == 0 then return 0 end
    local stolen, maxSteal = 0, CONFIG.StealCount > 0 and CONFIG.StealCount or #fruits
    for i, target in ipairs(fruits) do
        if not State.Running or stolen >= maxSteal or not IsNight() then break end
        if IsOwnerInGarden(target.OwnerUserId) then
            if not WaitForOwnerLeave(target.OwnerUserId) then continue end
        end
        if StealFruit(target) then stolen = stolen + 1 end
        task.wait(CONFIG.StealDelay)
    end
    return stolen
end

local function StealLoop()
    State.Running = true
    if CONFIG.Mode == "once" then RunStealCycle()
    elseif CONFIG.Mode == "loop" then
        while State.Running do
            if IsNight() then RunStealCycle() end
            local w = tick()
            while State.Running and tick()-w < CONFIG.LoopInterval do task.wait(1) end
        end
    elseif CONFIG.Mode == "smart" then
        while State.Running do
            if not IsNight() then while State.Running and not IsNight() do task.wait(5) end end
            if State.Running and IsNight() then RunStealCycle() end
            if State.Running and IsNight() then task.wait(15) end
        end
    end
    State.Running = false
end

local AutoSteal = {}
function AutoSteal.Start() if not State.Running then State.Thread = task.spawn(StealLoop) end end
function AutoSteal.Stop()
    State.Running = false
    if State.Stealing then pcall(function() Steal.CancelSteal:Fire() end); State.Stealing = false end
    if State.Thread then task.cancel(State.Thread); State.Thread = nil end
end
function AutoSteal.StealNow() return RunStealCycle() end
function AutoSteal.SetMode(m) if m=="once" or m=="loop" or m=="smart" then CONFIG.Mode = m end end
function AutoSteal.Preview()
    print("=== AutoSteal ==="); print("Night: "..tostring(IsNight()))
    if GardenZoneData then print("Players in gardens:"); for _,c in pairs(GardenZoneData:GetChildren()) do print(string.format("  %s -> Plot %s", c.Name, c.Value)) end end
    local fruits = FindStealableFruits()
    print("\nStealable: "..#fruits)
    for _,f in ipairs(fruits) do local p = Players:GetPlayerByUserId(f.OwnerUserId); print(string.format("  %s | Owner: %s%s | Hold: %.1fs", f.Plot, p and p.Name or "?", IsOwnerInGarden(f.OwnerUserId) and " [INGARDEN]" or "", f.HoldDuration)) end
end
function AutoSteal.Status() print("=== AutoSteal ==="); print("Running: "..tostring(State.Running)); print("Night: "..tostring(IsNight())); print(string.format("Stolen: %d | Failed: %d", State.Stats.Stolen, State.Stats.Failed)) end
function AutoSteal.UpdateConfig(c) for k,v in pairs(c) do if CONFIG[k] ~= nil then CONFIG[k] = v end end end

return AutoSteal
